{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Showcase GUI",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "Build Showcase GUI",
            "program": "${workspaceFolder}/target/debug/showcase-gui",
            "cwd": "${workspaceFolder}",
            "env": {
                "WAYLAND_DISPLAY": ""
            },
            "sourceLanguages": ["rust"]
        },
        {
            "name": "Showcase Python server",
            "type": "debugpy",
            "request": "launch",
            "module": "IPython",
            "args": [
                "-i",
                "--",
                "${workspaceFolder}/example/showcase/python/run.py",
                "--interactive"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Showcase Python server with web",
            "type": "debugpy",
            "request": "launch",
            "module": "IPython",
            "args": [
                "-i",
                "--",
                "${workspaceFolder}/example/showcase/python/run.py",
                "--interactive",
                "--web"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
